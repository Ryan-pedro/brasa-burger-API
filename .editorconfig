# Configuração de editor para todo o repositório — https://editorconfig.org
# O front-end tem um .editorconfig próprio, com regras específicas de TypeScript.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{cs,csproj,props,targets,sln}]
indent_size = 4
