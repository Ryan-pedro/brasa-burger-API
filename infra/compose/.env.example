# Copie para infra/compose/.env (o .env nunca vai para o Git) e preencha.

STORE_DOMAIN=pedidos.exemplo.com.br
ADMIN_DOMAIN=painel.exemplo.com.br
ACME_EMAIL=ti@exemplo.com.br

STORE_NAME=Brasa Burger
STORE_TIME_ZONE=America/Sao_Paulo

STOREFRONT_DIST=/opt/brasa/front/storefront
ADMIN_DIST=/opt/brasa/front/admin

# Banco gerenciado (recomendado) ou o contêiner do perfil banco-local (DB_HOST=postgres).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=brasa
DB_USER=brasa
DB_PASSWORD=troque-esta-senha
DB_SSL_MODE=Prefer

# Destino de logs, métricas e rastros (DP-12). Vazio: nada é exportado.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Pasta onde o script de backup grava as cópias, antes de enviá-las para fora da máquina.
BACKUP_DIR=/var/backups/brasa
BACKUP_RETENTION_DAYS=30
